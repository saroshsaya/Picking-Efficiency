# Copy to .streamlit/secrets.toml (local) or paste into the host's "Secrets" box.
# NEVER commit the real file. Use a READ-ONLY database user.

app_password = "choose-a-password"      # optional: asks for this before showing anything

[db]
host = "127.0.0.1"          # as seen from the SSH server (or the DB host if no tunnel)
port = 5432
user = "readonly_user"
password = "CHANGE-ME"
name = "samasya"

[ssh]                        # remove this whole section if the DB is reachable directly
enabled = true
host = "YOUR-SERVER-IP"
port = 22
user = "tunnel_user"         # a limited user - not root
password = "CHANGE-ME"       # or use private_key instead (see below)
# private_key = """-----BEGIN RSA PRIVATE KEY-----
# ...
# -----END RSA PRIVATE KEY-----"""
